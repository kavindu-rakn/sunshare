<?xml version="1.0" encoding="utf-8"?>
<!--
  File        : web.config
  Project     : SunShare - Smart Solar Microgrid Trading System
  Part        : B - Hosting (web app on IIS)
  Author      : Ranathunga R A K N (IT22552860)
  Created     : 2026-09-29
  Description : IIS settings for the built React app (site SunShareWeb, port
                8081). The app is plain static files: index.html is the start
                page, and the icon font type is declared so IIS serves it.
                HashRouter keeps page addresses after "#", so no URL rewrite
                rules are needed (decision D7).
  Note        : Vite copies this file from web/public into dist/ on every build.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- remove first, then add: avoids a "duplicate" error on IIS versions that already know .woff2 -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
