<?xml version="1.0" encoding="utf-8"?>
<!-- File: data_extraction_rules.xml | Part B (Android shell) | Backup rules for Android 12+:
     the phone's SQLite file (login token, cached stations, server address) is never copied to a
     cloud backup or to a new phone - after a restore the user simply logs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="sunshare_local.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="sunshare_local.db" />
    </device-transfer>
</data-extraction-rules>
