<?xml version="1.0" encoding="utf-8"?>
<!-- File: themes.xml | Part B (Android shell) | Material 3 light theme in the SunShare colours. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SunShare" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ss_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/ss_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/ss_primary_dark</item>
        <item name="colorSecondary">@color/ss_accent</item>
        <item name="colorOnSecondary">@color/ss_dark</item>
        <item name="colorSecondaryContainer">@color/ss_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/ss_dark</item>
        <item name="colorError">@color/ss_danger</item>
        <item name="android:colorBackground">@color/ss_bg</item>
        <item name="android:windowBackground">@color/ss_bg</item>
        <item name="colorOnBackground">@color/ss_text</item>
        <item name="colorOnSurface">@color/ss_text</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.SunShare" parent="Base.Theme.SunShare" />

    <!-- Navy top bar used on inner screens: white title, grey subtitle, white back arrow. -->
    <style name="Widget.SunShare.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/ss_dark</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/ss_grey</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <!-- Red line under a form that shows the API's error message (hidden until needed). -->
    <style name="TextAppearance.SunShare.Error" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ss_danger</item>
    </style>
</resources>
