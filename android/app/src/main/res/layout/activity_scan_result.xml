<?xml version="1.0" encoding="utf-8"?>
<!-- File: activity_scan_result.xml | Part D | M11 Scan result: verified booking + Finalize, or the reason it can't be used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ss_bg"
    android:orientation="vertical"
    tools:context=".ui.operator.ScanResultActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SunShare.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/scan_result_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- While the server checks the QR code -->
            <LinearLayout
                android:id="@+id/checking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/checking_qr"
                    android:textColor="@color/ss_muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- The result: ✓ verified or ✕ not valid -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:strokeWidth="2dp"
                tools:strokeColor="@color/ss_success"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textResultIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_status_badge"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:backgroundTint="@color/ss_success"
                            tools:text="✓" />

                        <TextView
                            android:id="@+id/textResultTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:textColor="@color/ss_dark"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Verified with server" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/ss_danger"
                        android:textSize="16sp"
                        android:visibility="gone"
                        tools:text="This booking is already completed - a QR code can only be used once." />

                    <!-- Booking details, only when verified -->
                    <LinearLayout
                        android:id="@+id/bookingDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/textProsumer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ss_dark"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Nimal Perera (199712345678)" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textStation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/ss_text"
                                android:textSize="16sp"
                                tools:text="Malabe Solar Hub" />

                            <TextView
                                android:id="@+id/textStatus"
                                style="@style/Widget.SunShare.StatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                tools:text="Approved" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/ss_text"
                            android:textSize="16sp"
                            tools:text="Wed, 30 Sep, 11:00 - 13:00" />

                        <TextView
                            android:id="@+id/textEnergy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/ss_text"
                            android:textSize="16sp"
                            tools:text="12.5 kWh · Sell" />

                        <TextView
                            android:id="@+id/textBookingId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/ss_muted"
                            android:textSize="13sp"
                            tools:text="Booking ID 6abb6457eb5429ade68d6395" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFinalize"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:text="@string/finalize_transfer"
                android:textSize="17sp"
                android:visibility="gone"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBack"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/back_to_home" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
