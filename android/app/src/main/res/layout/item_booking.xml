<?xml version="1.0" encoding="utf-8"?>
<!-- File: item_booking.xml | Part D | One row (card) in the My bookings list (M8). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/ss_primary_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textStation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ss_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Malabe Solar Hub" />

            <TextView
                android:id="@+id/textStatus"
                style="@style/Widget.SunShare.StatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="Approved" />
        </LinearLayout>

        <TextView
            android:id="@+id/textTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ss_text"
            android:textSize="15sp"
            tools:text="Wed, 30 Sep, 11:00 - 12:00" />

        <TextView
            android:id="@+id/textEnergy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ss_muted"
            android:textSize="14sp"
            tools:text="12.5 kWh · Sell" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
