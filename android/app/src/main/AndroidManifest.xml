<?xml version="1.0" encoding="utf-8"?>
<!-- File: AndroidManifest.xml | Part B (Android shell) | App name, icon, permissions, screens and the Maps key. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Call the SunShare API over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Grid Operators scan QR codes with the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Find the phone's location for "nearby stations". -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The camera is used but not required (the app still installs on devices without one). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SunShare">

        <!-- Google Maps (JavaScript API) key, filled from local.properties at build time (see app/build.gradle.kts).
             StationMapActivity reads it and puts it into the map page (D53). -->
        <meta-data
            android:name="com.sunshare.app.MAPS_API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- M1 Login (Part A) - the app's first screen -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- M2 Register (Part A) -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- M4 Profile (Part A) -->
        <activity
            android:name=".ui.prosumer.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- M3 Prosumer Home (Part D) -->
        <activity
            android:name=".ui.prosumer.ProsumerHomeActivity"
            android:exported="false" />
        <!-- M8 My bookings (Part D) -->
        <activity
            android:name=".ui.prosumer.BookingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- M9 Booking details (Part D) -->
        <activity
            android:name=".ui.prosumer.ReservationDetailActivity"
            android:exported="false" />
        <!-- M6 Booking form (Part C) -->
        <activity
            android:name=".ui.prosumer.ReservationFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- M7 Summary (Part C) -->
        <activity
            android:name=".ui.prosumer.ReservationSummaryActivity"
            android:exported="false" />
        <!-- M5 Nearby stations map (Part B) -->
        <activity
            android:name=".ui.map.StationMapActivity"
            android:exported="false" />
        <!-- M10 Operator Home (Part D) -->
        <activity
            android:name=".ui.operator.OperatorHomeActivity"
            android:exported="false" />
        <!-- M11 Scan result (Part D) -->
        <activity
            android:name=".ui.operator.ScanResultActivity"
            android:exported="false" />
        <!-- QR scanner (Part D): ZXing's scanner screen, kept clear of the phone's bars; turns with the phone -->
        <activity
            android:name=".ui.operator.QrScanActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
    </application>

</manifest>
