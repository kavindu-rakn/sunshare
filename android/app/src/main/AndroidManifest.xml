<?xml version="1.0" encoding="utf-8"?>
<!-- File: AndroidManifest.xml | Part B (Android shell) | App name, icon, permissions, screens and the Maps key. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Call the SunShare API over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Grid Operators scan QR codes with the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Find the phone's location for "nearby stations". -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The camera is used but not required (the app still installs on devices without one). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SunShare">

        <!-- Google Maps key, filled from local.properties at build time (see app/build.gradle.kts). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M3 Prosumer Home (Part D) -->
        <activity
            android:name=".ui.prosumer.ProsumerHomeActivity"
            android:exported="false" />
        <!-- M10 Operator Home (Part D) -->
        <activity
            android:name=".ui.operator.OperatorHomeActivity"
            android:exported="false" />
    </application>

</manifest>
