<?xml version="1.0" encoding="utf-8"?>
<!--
  File        : web.config
  Project     : SunShare - Smart Solar Microgrid Trading System
  Part        : B - Shared foundation (hosting)
  Author      : Ranathunga R A K N (IT22552860)
  Created     : 2026-09-28
  Description : Tells IIS how to run the API (through the ASP.NET Core Module
                from the Hosting Bundle) and removes WebDAV, which would
                otherwise answer PUT/DELETE/PATCH with "405 Method Not Allowed".
  Reference   : Microsoft Learn, "Host ASP.NET Core on Windows with IIS"
                https://learn.microsoft.com/en-us/aspnet/core/host-and-deploy/iis/
  Note        : dotnet publish fills in processPath/arguments for the published app.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SunShare.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
